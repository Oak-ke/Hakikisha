# --- WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

# --- Reputation checks (optional; each is skipped if empty) ---
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# --- LLM review (optional) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# --- Behaviour ---
USE_BROWSER=false
ENABLE_WHOIS=true
DB_PATH=hakiki.db
ADMIN_TOKEN=pick-a-long-random-string
# Sites allowed to call /check from the browser (comma-separated)
ALLOWED_ORIGINS=https://oak-ke.github.io
